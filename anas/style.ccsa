/* RESET */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --background: #07111f;
    --surface: #0d1b2d;
    --primary: #287bff;
    --accent: #64c7ff;
    --text: #f5f8ff;
    --muted: #9aacc3;
    --border: rgba(100, 199, 255, 0.18);
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.7;
}

a {
    text-decoration: none;
    color: inherit;
}

.navbar {
    min-height: 80px;
    padding: 20px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    border-bottom: 1px solid var(--border);
    background: #07111f;
}

.logo {
    font-size: 27px;
    font-weight: 900;
    letter-spacing: 2px;
}

.logo span,
.hero h1 span {
    color: var(--accent);
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
}

nav a {
    color: var(--muted);
    font-size: 14px;
    transition: color 0.3s;
}

nav a:hover {
    color: var(--accent);
}

.hero {
    min-height: 570px;
    padding: 90px 8%;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: center;
    gap: 55px;
    background:
        radial-gradient(ellipse at 85% 45%,
        rgba(40, 123, 255, 0.18), transparent 45%);
}

.label {
    color: var(--accent);
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 3px;
    margin-bottom: 15px;
}

.hero h1 {
    font-size: clamp(36px, 5vw, 60px);
    line-height: 1.15;
    margin-bottom: 24px;
}

.description {
    max-width: 540px;
    color: var(--muted);
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
}

.btn-primary,
.btn-secondary {
    display: inline-block;
    padding: 12px 22px;
    border-radius: 8px;
    font-weight: bold;
    font-size: 14px;
    transition: 0.3s;
}

.btn-primary {
    background: var(--primary);
    color: white;
    border: 1px solid var(--primary);
}

.btn-primary:hover {
    background: #1766e8;
    transform: translateY(-2px);
}

.btn-secondary {
    border: 1px solid var(--border);
    color: var(--text);
}

.btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
}

.hero-card {
    padding: 38px 25px;
    text-align: center;
    border: 1px solid var(--border);
    border-radius: 22px;
    background: linear-gradient(145deg, #102742, #091525);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
}

.wifi-icon {
    width: 100px;
    height: 100px;
    margin: 0 auto 20px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 65px;
    color: var(--accent);
    background: rgba(40, 123, 255, 0.15);
    border: 1px solid var(--border);
}

.card-label {
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 2px;
}

.hero-card h2 {
    font-size: 23px;
    margin: 8px 0;
}

.hero-card > p:last-of-type {
    color: var(--muted);
    font-size: 12px;
}

.signal {
    display: flex;
    justify-content: center;
    align-items: end;
    gap: 8px;
    height: 35px;
    margin-top: 25px;
}

.signal span {
    width: 12px;
    border-radius: 5px;
    background: var(--accent);
}

.signal span:nth-child(1) { height: 12px; }
.signal span:nth-child(2) { height: 19px; }
.signal span:nth-child(3) { height: 25px; }
.signal span:nth-child(4) { height: 30px; }
.signal span:nth-child(5) { height: 35px; }

.section {
    padding: 85px 8%;
}

.services {
    text-align: center;
}

.section-title {
    font-size: clamp(27px, 4vw, 38px);
    line-height: 1.25;
    margin-bottom: 14px;
}

.section-description {
    color: var(--muted);
    margin-bottom: 42px;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    margin-top: 40px;
    text-align: left;
}

.service-card {
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 15px;
    transition: transform 0.3s, border-color 0.3s;
}

.service-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent);
}

.service-icon {
    font-size: 32px;
    color: var(--accent);
    margin-bottom: 15px;
}

.service-card h3 {
    margin-bottom: 10px;
}

.service-card p,
.about > p,
.contact > p {
    color: var(--muted);
}

.about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 55px;
    align-items: center;
    background: #091626;
}

.contact {
    text-align: center;
}

.contact h2 {
    font-size: clamp(28px, 4vw, 40px);
    margin-bottom: 15px;
}

.contact > p {
    margin-bottom: 28px;
}

footer {
    padding: 28px 8%;
    border-top: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

footer p {
    color: var(--muted);
    font-size: 12px;
}

/* RESPONSIVE UNTUK HP */
@media (max-width: 768px) {
    .navbar {
        flex-direction: column;
        padding: 20px 5%;
    }

    nav {
        justify-content: center;
        gap: 12px 20px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 65px 6%;
        gap: 40px;
    }

    .hero-card {
        max-width: 420px;
        width: 100%;
        margin: auto;
    }

    .section {
        padding: 65px 6%;
    }

    .service-grid {
        grid-template-columns: 1fr;
    }

    .about {
        grid-template-columns: 1fr;
        gap: 20px;
    }

    footer {
        flex-direction: column;
        text-align: center;
    }
}
